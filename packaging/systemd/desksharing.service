[Unit]
Description=Desksharing
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=desksharing
Group=desksharing
WorkingDirectory=/var/lib/desksharing
EnvironmentFile=/etc/desksharing/desksharing.env
ExecStart=/usr/bin/desksharing
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/desksharing
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
