APP_ENV=production
HTTP_ADDR=127.0.0.1:8081
AUTO_MIGRATE=true
DATA_DIR=/var/lib/desksharing
# Android-App: /var/lib/desksharing/mobile/desksharing.apk ablegen, dann desksharing-fix-mobile-perms
DEV_RETURN_TOKENS=false
TRUST_PROXY=true

PUBLIC_BASE_URL=https://desksharing.example.com

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=desksharing
POSTGRES_DB=desksharing
POSTGRES_SSLMODE=require
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://desksharing:CHANGE_ME@127.0.0.1:5432/desksharing?sslmode=require

PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME
PLATFORM_ADMIN_NAME=Platform Admin

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
