POSTGRES_USER=desksharing
POSTGRES_PASSWORD=desksharing
POSTGRES_DB=desksharing
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_SSLMODE=disable

DATABASE_URL=postgres://desksharing:desksharing@127.0.0.1:5435/desksharing?sslmode=disable
DATA_DIR=./data
HTTP_ADDR=:8081
AUTO_MIGRATE=true
PUBLIC_BASE_URL=http://localhost:8081
DEV_RETURN_TOKENS=true

# Optional: created on first server start if missing
PLATFORM_ADMIN_EMAIL=admin@desksharing.local
PLATFORM_ADMIN_PASSWORD=changeme123
PLATFORM_ADMIN_NAME=Platform Admin

# SMTP (Host + From erforderlich für echten Versand)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Desksharing <noreply@example.com>
SMTP_TLS=starttls
