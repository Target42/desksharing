# development lässt lokale Defaults zu. production bricht beim Start ab,
# wenn Tokens zurückgegeben werden, das Admin-Passwort schwach ist,
# die Datenbank ohne TLS oder mit Standardpasswort läuft, oder SMTP fehlt.
APP_ENV=development

POSTGRES_USER=desksharing
POSTGRES_PASSWORD=desksharing
POSTGRES_DB=desksharing
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_SSLMODE=disable

DATABASE_URL=postgres://desksharing:desksharing@127.0.0.1:5435/desksharing?sslmode=disable
DATA_DIR=./data
# Android-APK für den Download auf der Website: DATA_DIR/mobile/desksharing.apk
HTTP_ADDR=:8081
AUTO_MIGRATE=true
PUBLIC_BASE_URL=http://localhost:8081

# Nur lokal. In production muss das false sein (und ist der Code-Default).
DEV_RETURN_TOKENS=true

# Hinter genau einem Reverse Proxy true setzen.
# Nginx soll X-Real-IP mit $remote_addr überschreiben, nicht vom Client übernehmen.
# Die Sitzung bleibt host-only und gilt nicht für andere Subdomains auf demselben Server.
TRUST_PROXY=false

# Optional: created on first server start if missing.
# production verlangt mindestens 12 Zeichen und lehnt changeme123 ab.
PLATFORM_ADMIN_EMAIL=admin@desksharing.local
PLATFORM_ADMIN_PASSWORD=changeme123
PLATFORM_ADMIN_NAME=Platform Admin

# SMTP (Host + From erforderlich für echten Versand)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Desksharing <noreply@example.com>
SMTP_TLS=starttls
